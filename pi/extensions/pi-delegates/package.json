{
    "name": "@local/pi-delegates",
    "version": "0.1.0",
    "private": true,
    "keywords": [
        "pi-extension",
        "pi-package"
    ],
    "type": "module",
    "scripts": {
        "check": "tsc --noEmit -p tsconfig.json",
        "test:build": "tsc -p tsconfig.test.json",
        "test": "npm run test:build && node --test .test-build/tests/*.test.js",
        "test:live": "npm run test:build && PI_DELEGATES_LIVE=1 node --test .test-build/tests/live/*.test.js",
        "format": "oxfmt --write \"**/*.{ts,json,md}\"",
        "format:check": "oxfmt --check \"**/*.{ts,json,md}\""
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "^0.82.0",
        "@earendil-works/pi-tui": "^0.82.0",
        "@types/node": "^24.0.0",
        "oxfmt": "^0.61.0",
        "typebox": "^1.3.6",
        "typescript": "^5.9.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "pi": {
        "extensions": [
            "./index.ts"
        ]
    }
}
