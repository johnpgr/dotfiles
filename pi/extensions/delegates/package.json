{
  "name": "@local/pi-delegates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test .test-build/tests/*.test.js",
    "test:live": "npm run test:build && PI_DELEGATES_LIVE=1 node --test .test-build/tests/live/*.test.js",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typebox": "^1.3.6",
    "typescript": "^5.9.0"
  }
}
